export function ErrorFallback({ error, resetErrorBoundary }) {
  return (
    <div>
      <h2>Something went wrong 😢</h2>
      <p>{error.message}</p>

      <button onClick={resetErrorBoundary}>
        Try again Rmani...
      </button>
    </div>
  );
}


